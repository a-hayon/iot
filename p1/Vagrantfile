# -*- mode: ruby -*-
# vi: set ft=ruby :

Vagrant.configure("2") do |config|

  config.vm.box = "debian/bookworm64"

  config.vm.provider "virtualbox" do |vb|
    vb.memory = 2048
    vb.cpus = 2
  end

  # the server node manages the cluster with the control plane and teh kubernetes API
  config.vm.define "ahayonS" do |server| 
    server.vm.hostname = "ahayonS"
    # virtualbox adds an additional network interface to the vm 
    # both vms will be on the same virtualbox basic private network and will be able to communicate with these adresses
    server.vm.network "private_network", ip: "192.168.56.110" 

    server.vm.provision "shell", path: "scripts/server.sh"
  end

  # l'agent est la pour fournir des ressources d'exec au cluster (CPU / RAM / execution de pods)
  config.vm.define "ahayonSW" do |serverworker|
    serverworker.vm.hostname = "ahayonSW"
    serverworker.vm.network "private_network", ip: "192.168.56.111"

    serverworker.vm.provision "shell", path: "scripts/worker.sh"
  end
end